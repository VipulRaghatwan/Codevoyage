# ==============================================================================
# CODEVOYAGE Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Backend Configuration
BACKEND_PORT=8080
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
POSTGRES_DB=codevoyage_db
POSTGRES_USER=codevoyage_admin
POSTGRES_PASSWORD=change_this_in_production_super_secret_db_pass
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codevoyage_db

# Security & JWT (HMAC-SHA256 secret minimum 256 bits / 32 characters)
JWT_SECRET=super_secret_space_voyage_jwt_signing_key_at_least_256_bits_long_for_security_2026!
JWT_EXPIRATION_MS=86400000

# Sandbox Execution Service
EXECUTION_SERVICE_URL=http://localhost:5050
EXECUTION_SERVICE_PORT=5050
EXECUTION_TIMEOUT_MS=5000

# Frontend Configuration
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
